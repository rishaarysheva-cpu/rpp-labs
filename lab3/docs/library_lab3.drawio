        <mxCell id="note0" value="Раскрытие REN · обработка одного запроса продления" style="text;html=0;whiteSpace=wrap;fontColor=#000000;fontFamily=DejaVu Sans;fontSize=27;" vertex="1" parent="1" bpmnType="annotation">
