<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="LibraryDefinitions" targetNamespace="urn:rpp:library:lab3">
  <bpmn:process id="LibraryProcess" name="Жизненный цикл одной заявки Loan" isExecutable="false">
    <bpmn:laneSet id="LibraryLanes">
      <bpmn:lane id="SystemLane" name="Информационная система">
        <bpmn:flowNodeRef>p1_S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_Q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_WQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_WA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_EX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_NX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_FUND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_MX</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_EE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_LA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_M0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_GF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_WR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_REM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_WR2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_OV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_MM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_MT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_REN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_WR3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_MR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_LBK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_BL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_ADM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p2_EA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_ST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_OR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_FL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_FD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_FZ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_OR2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_SUM</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="LibrarianLane" name="Библиотекарь">
        <bpmn:flowNodeRef>p1_CK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_I</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_LA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p1_ED</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_LBK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_RC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_AND1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_IN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_AND2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_CL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>p4_EC</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="p1_S" name="Заявка">
      <bpmn:outgoing>p1_e1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="p1_S_message"/>
    </bpmn:startEvent>
    <bpmn:task id="p1_A" name="A  Проверить наличие">
      <bpmn:incoming>p1_e1</bpmn:incoming>
      <bpmn:outgoing>p1_e2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p1_G1" name="Есть экземпляр?" gatewayDirection="Diverging">
      <bpmn:incoming>p1_e2</bpmn:incoming>
      <bpmn:outgoing>p1_e3</bpmn:outgoing>
      <bpmn:outgoing>p1_e4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p1_Q" name="Q  Поставить в очередь">
      <bpmn:incoming>p1_e4</bpmn:incoming>
      <bpmn:outgoing>p1_e5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="p1_WQ" name="Копия доступна; очередь подошла">
      <bpmn:incoming>p1_e5</bpmn:incoming>
      <bpmn:outgoing>p1_e6</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="p1_WQ_condition">
        <bpmn:condition>available_copies &gt; 0 and first_in_queue</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="p1_R" name="R  Оформить бронь на 3 рабочих дня">
      <bpmn:incoming>p1_e3</bpmn:incoming>
      <bpmn:incoming>p1_e6</bpmn:incoming>
      <bpmn:outgoing>p1_e7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="p1_WA" name="WA  Ожидать прихода читателя">
      <bpmn:incoming>p1_e7</bpmn:incoming>
      <bpmn:outgoing>p1_e8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="p1_T1" name="T1" attachedToRef="p1_WA" cancelActivity="true">
      <bpmn:outgoing>p1_e9</bpmn:outgoing>
      <bpmn:timerEventDefinition id="p1_T1_timer">
        <bpmn:timeDate>reserved_until</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="p1_EX" name="EX  Снять бронь и освободить копию">
      <bpmn:incoming>p1_e9</bpmn:incoming>
      <bpmn:outgoing>p1_e10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p1_G3" name="Есть очередь?" gatewayDirection="Diverging">
      <bpmn:incoming>p1_e10</bpmn:incoming>
      <bpmn:outgoing>p1_e11</bpmn:outgoing>
      <bpmn:outgoing>p1_e12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="p1_NX" name="NX  Бронь первому в очереди FIFO">
      <bpmn:incoming>p1_e11</bpmn:incoming>
      <bpmn:outgoing>p1_e13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p1_FUND" name="Оставить копию доступной">
      <bpmn:incoming>p1_e12</bpmn:incoming>
      <bpmn:outgoing>p1_e14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p1_MX" name="" gatewayDirection="Converging">
      <bpmn:incoming>p1_e13</bpmn:incoming>
      <bpmn:incoming>p1_e14</bpmn:incoming>
      <bpmn:outgoing>p1_e15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="p1_EE" name="Бронь снята">
      <bpmn:incoming>p1_e15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="p1_CK" name="CK  Проверить долг, просрочки и билет">
      <bpmn:incoming>p1_e8</bpmn:incoming>
      <bpmn:outgoing>p1_e16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="p1_G2" name="Можно выдать?" gatewayDirection="Diverging">
      <bpmn:incoming>p1_e16</bpmn:incoming>
      <bpmn:outgoing>p1_e17</bpmn:outgoing>
      <bpmn:outgoing>p1_e19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="p1_I" name="I  Выдать книгу на 14 дней">
      <bpmn:incoming>p1_e17</bpmn:incoming>
      <bpmn:outgoing>p1_e18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="p1_LA" name="A">
      <bpmn:incoming>p1_e18</bpmn:incoming>
      <bpmn:linkEventDefinition id="p1_LA_link" name="A"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="p1_D" name="D  Отклонить выдачу, освободить копию, активировать очередь">
      <bpmn:incoming>p1_e19</bpmn:incoming>
      <bpmn:outgoing>p1_e20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p1_ED" name="Выдача отклонена">
      <bpmn:incoming>p1_e20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p1_e1" sourceRef="p1_S" targetRef="p1_A"/>
    <bpmn:sequenceFlow id="p1_e2" sourceRef="p1_A" targetRef="p1_G1"/>
    <bpmn:sequenceFlow id="p1_e3" sourceRef="p1_G1" targetRef="p1_R" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_available_copy(book)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p1_e4" sourceRef="p1_G1" targetRef="p1_Q" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">no_available_copy(book)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p1_e5" sourceRef="p1_Q" targetRef="p1_WQ"/>
    <bpmn:sequenceFlow id="p1_e6" sourceRef="p1_WQ" targetRef="p1_R"/>
    <bpmn:sequenceFlow id="p1_e7" sourceRef="p1_R" targetRef="p1_WA"/>
    <bpmn:sequenceFlow id="p1_e8" sourceRef="p1_WA" targetRef="p1_CK"/>
    <bpmn:sequenceFlow id="p1_e9" sourceRef="p1_T1" targetRef="p1_EX"/>
    <bpmn:sequenceFlow id="p1_e10" sourceRef="p1_EX" targetRef="p1_G3"/>
    <bpmn:sequenceFlow id="p1_e11" sourceRef="p1_G3" targetRef="p1_NX" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">queue_exists(loans, book_id)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p1_e12" sourceRef="p1_G3" targetRef="p1_FUND" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">queue_empty(loans, book_id)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p1_e13" sourceRef="p1_NX" targetRef="p1_MX"/>
    <bpmn:sequenceFlow id="p1_e14" sourceRef="p1_FUND" targetRef="p1_MX"/>
    <bpmn:sequenceFlow id="p1_e15" sourceRef="p1_MX" targetRef="p1_EE"/>
    <bpmn:sequenceFlow id="p1_e16" sourceRef="p1_CK" targetRef="p1_G2"/>
    <bpmn:sequenceFlow id="p1_e17" sourceRef="p1_G2" targetRef="p1_I" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reader_is_eligible(reader, overdue)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p1_e18" sourceRef="p1_I" targetRef="p1_LA"/>
    <bpmn:sequenceFlow id="p1_e19" sourceRef="p1_G2" targetRef="p1_D" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reader_is_ineligible(reader, overdue)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p1_e20" sourceRef="p1_D" targetRef="p1_ED"/>
    <bpmn:intermediateCatchEvent id="p2_LA" name="A">
      <bpmn:outgoing>p2_e1</bpmn:outgoing>
      <bpmn:linkEventDefinition id="p2_LA_link" name="A"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="p2_M0" name="" gatewayDirection="Converging">
      <bpmn:incoming>p2_e1</bpmn:incoming>
      <bpmn:incoming>p2_e9</bpmn:incoming>
      <bpmn:incoming>p2_e12</bpmn:incoming>
      <bpmn:outgoing>p2_e2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_GF" name="Напоминание уже отправлено?" gatewayDirection="Diverging">
      <bpmn:incoming>p2_e2</bpmn:incoming>
      <bpmn:outgoing>p2_e3</bpmn:outgoing>
      <bpmn:outgoing>p2_e4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="p2_WR1" name="WR1  Ожидать возврат / продление">
      <bpmn:incoming>p2_e3</bpmn:incoming>
      <bpmn:outgoing>p2_e5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="p2_T2" name="T2" attachedToRef="p2_WR1" cancelActivity="true">
      <bpmn:outgoing>p2_e11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="p2_T2_timer">
        <bpmn:timeDate>due_at - P2D</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="p2_REM" name="REM  Отправить напоминание">
      <bpmn:incoming>p2_e11</bpmn:incoming>
      <bpmn:outgoing>p2_e12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="p2_WR2" name="WR2  Ожидать возврат / продление">
      <bpmn:incoming>p2_e4</bpmn:incoming>
      <bpmn:outgoing>p2_e6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="p2_T3" name="T3" attachedToRef="p2_WR2" cancelActivity="true">
      <bpmn:outgoing>p2_e13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="p2_T3_timer">
        <bpmn:timeDate>start_of_day(due_on + P1D)</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="p2_OV" name="OV  Зафиксировать просрочку">
      <bpmn:incoming>p2_e13</bpmn:incoming>
      <bpmn:outgoing>p2_e14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="p2_MM" name="" gatewayDirection="Converging">
      <bpmn:incoming>p2_e5</bpmn:incoming>
      <bpmn:incoming>p2_e6</bpmn:incoming>
      <bpmn:outgoing>p2_e7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="p2_MT" name="Тип сообщения?" gatewayDirection="Diverging">
      <bpmn:incoming>p2_e7</bpmn:incoming>
      <bpmn:outgoing>p2_e8</bpmn:outgoing>
      <bpmn:outgoing>p2_e10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="p2_REN" name="REN  Обработать запрос продления">
      <bpmn:incoming>p2_e8</bpmn:incoming>
      <bpmn:outgoing>p2_e9</bpmn:outgoing>
      <bpmn:startEvent id="ren_RS" name="Начало REN">
        <bpmn:outgoing>ren_e1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="ren_UGR" name="Можно продлить?" gatewayDirection="Diverging">
        <bpmn:incoming>ren_e1</bpmn:incoming>
        <bpmn:outgoing>ren_e2</bpmn:outgoing>
        <bpmn:outgoing>ren_e3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="ren_UREN" name="UREN  Продлить на 7 дней renewed = true reminded = false">
        <bpmn:incoming>ren_e2</bpmn:incoming>
        <bpmn:outgoing>ren_e4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="ren_UDEN" name="UDEN  Сообщить отказ Срок и флаги сохранить">
        <bpmn:incoming>ren_e3</bpmn:incoming>
        <bpmn:outgoing>ren_e5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="ren_UM" name="" gatewayDirection="Converging">
        <bpmn:incoming>ren_e4</bpmn:incoming>
        <bpmn:incoming>ren_e5</bpmn:incoming>
        <bpmn:outgoing>ren_e6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="ren_RE" name="Конец REN">
        <bpmn:incoming>ren_e6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="ren_e1" sourceRef="ren_RS" targetRef="ren_UGR" name=""/>
      <bpmn:sequenceFlow id="ren_e2" sourceRef="ren_UGR" targetRef="ren_UREN" name="да">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">renewal_is_allowed(loan, has_queue, now)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ren_e3" sourceRef="ren_UGR" targetRef="ren_UDEN" name="нет">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">renewal_is_denied(loan, has_queue, now)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="ren_e4" sourceRef="ren_UREN" targetRef="ren_UM" name=""/>
      <bpmn:sequenceFlow id="ren_e5" sourceRef="ren_UDEN" targetRef="ren_UM" name=""/>
      <bpmn:sequenceFlow id="ren_e6" sourceRef="ren_UM" targetRef="ren_RE" name=""/>
    </bpmn:subProcess>
    <bpmn:receiveTask id="p2_WR3" name="WR3  Ожидать возврат книги">
      <bpmn:incoming>p2_e14</bpmn:incoming>
      <bpmn:outgoing>p2_e15</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:boundaryEvent id="p2_T4" name="T4" attachedToRef="p2_WR3" cancelActivity="true">
      <bpmn:outgoing>p2_e17</bpmn:outgoing>
      <bpmn:timerEventDefinition id="p2_T4_timer">
        <bpmn:timeDate>start_of_day(due_on + P30D)</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="p2_MR" name="" gatewayDirection="Converging">
      <bpmn:incoming>p2_e10</bpmn:incoming>
      <bpmn:incoming>p2_e15</bpmn:incoming>
      <bpmn:outgoing>p2_e16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="p2_LBK" name="Б">
      <bpmn:incoming>p2_e16</bpmn:incoming>
      <bpmn:linkEventDefinition id="p2_LBK_link" name="Б"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:task id="p2_BL" name="BL  Блокировать читательский билет">
      <bpmn:incoming>p2_e17</bpmn:incoming>
      <bpmn:outgoing>p2_e18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p2_ADM" name="ADM  Передать дело администрации">
      <bpmn:incoming>p2_e18</bpmn:incoming>
      <bpmn:outgoing>p2_e19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="p2_EA" name="Передана администрации">
      <bpmn:incoming>p2_e19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p2_e1" sourceRef="p2_LA" targetRef="p2_M0"/>
    <bpmn:sequenceFlow id="p2_e2" sourceRef="p2_M0" targetRef="p2_GF"/>
    <bpmn:sequenceFlow id="p2_e3" sourceRef="p2_GF" targetRef="p2_WR1" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not reminded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p2_e4" sourceRef="p2_GF" targetRef="p2_WR2" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">reminded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p2_e5" sourceRef="p2_WR1" targetRef="p2_MM"/>
    <bpmn:sequenceFlow id="p2_e6" sourceRef="p2_WR2" targetRef="p2_MM"/>
    <bpmn:sequenceFlow id="p2_e7" sourceRef="p2_MM" targetRef="p2_MT"/>
    <bpmn:sequenceFlow id="p2_e8" sourceRef="p2_MT" targetRef="p2_REN" name="продление">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">message.type == renew</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p2_e9" sourceRef="p2_REN" targetRef="p2_M0"/>
    <bpmn:sequenceFlow id="p2_e10" sourceRef="p2_MT" targetRef="p2_MR" name="возврат">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">message.type == return</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p2_e11" sourceRef="p2_T2" targetRef="p2_REM"/>
    <bpmn:sequenceFlow id="p2_e12" sourceRef="p2_REM" targetRef="p2_M0"/>
    <bpmn:sequenceFlow id="p2_e13" sourceRef="p2_T3" targetRef="p2_OV"/>
    <bpmn:sequenceFlow id="p2_e14" sourceRef="p2_OV" targetRef="p2_WR3"/>
    <bpmn:sequenceFlow id="p2_e15" sourceRef="p2_WR3" targetRef="p2_MR"/>
    <bpmn:sequenceFlow id="p2_e16" sourceRef="p2_MR" targetRef="p2_LBK"/>
    <bpmn:sequenceFlow id="p2_e17" sourceRef="p2_T4" targetRef="p2_BL"/>
    <bpmn:sequenceFlow id="p2_e18" sourceRef="p2_BL" targetRef="p2_ADM"/>
    <bpmn:sequenceFlow id="p2_e19" sourceRef="p2_ADM" targetRef="p2_EA"/>
    <bpmn:intermediateCatchEvent id="p4_LBK" name="Б">
      <bpmn:outgoing>p4_e1</bpmn:outgoing>
      <bpmn:linkEventDefinition id="p4_LBK_link" name="Б"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="p4_RC" name="RC  Принять возврат книги">
      <bpmn:incoming>p4_e1</bpmn:incoming>
      <bpmn:outgoing>p4_e2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="p4_AND1" name="" gatewayDirection="Diverging">
      <bpmn:incoming>p4_e2</bpmn:incoming>
      <bpmn:outgoing>p4_e3</bpmn:outgoing>
      <bpmn:outgoing>p4_e4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="p4_ST" name="ST  Вернуть копию в фонд и активировать очередь">
      <bpmn:incoming>p4_e3</bpmn:incoming>
      <bpmn:outgoing>p4_e14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="p4_IN" name="IN  Осмотреть книгу, зафиксировать акт при повреждении">
      <bpmn:incoming>p4_e4</bpmn:incoming>
      <bpmn:outgoing>p4_e5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:inclusiveGateway id="p4_OR1" name="Причины штрафа" gatewayDirection="Diverging" default="p4_e8">
      <bpmn:incoming>p4_e5</bpmn:incoming>
      <bpmn:outgoing>p4_e6</bpmn:outgoing>
      <bpmn:outgoing>p4_e7</bpmn:outgoing>
      <bpmn:outgoing>p4_e8</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="p4_FL" name="FL  Просрочка 15 × дней">
      <bpmn:incoming>p4_e6</bpmn:incoming>
      <bpmn:outgoing>p4_e9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p4_FD" name="FD  Повреждение 500 RUB по акту">
      <bpmn:incoming>p4_e7</bpmn:incoming>
      <bpmn:outgoing>p4_e10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p4_FZ" name="FZ  Нулевой штраф">
      <bpmn:incoming>p4_e8</bpmn:incoming>
      <bpmn:outgoing>p4_e11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="p4_OR2" name="" gatewayDirection="Converging">
      <bpmn:incoming>p4_e9</bpmn:incoming>
      <bpmn:incoming>p4_e10</bpmn:incoming>
      <bpmn:incoming>p4_e11</bpmn:incoming>
      <bpmn:outgoing>p4_e12</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="p4_SUM" name="SUM  Сложить суммы и сохранить Money">
      <bpmn:incoming>p4_e12</bpmn:incoming>
      <bpmn:outgoing>p4_e13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="p4_AND2" name="" gatewayDirection="Converging">
      <bpmn:incoming>p4_e13</bpmn:incoming>
      <bpmn:incoming>p4_e14</bpmn:incoming>
      <bpmn:outgoing>p4_e15</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="p4_CL" name="CL  Закрыть выдачу и начислить долг">
      <bpmn:incoming>p4_e15</bpmn:incoming>
      <bpmn:outgoing>p4_e16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="p4_EC" name="Выдача закрыта">
      <bpmn:incoming>p4_e16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="p4_e1" sourceRef="p4_LBK" targetRef="p4_RC"/>
    <bpmn:sequenceFlow id="p4_e2" sourceRef="p4_RC" targetRef="p4_AND1"/>
    <bpmn:sequenceFlow id="p4_e3" sourceRef="p4_AND1" targetRef="p4_ST"/>
    <bpmn:sequenceFlow id="p4_e4" sourceRef="p4_AND1" targetRef="p4_IN"/>
    <bpmn:sequenceFlow id="p4_e5" sourceRef="p4_IN" targetRef="p4_OR1"/>
    <bpmn:sequenceFlow id="p4_e6" sourceRef="p4_OR1" targetRef="p4_FL" name="есть просрочка">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_overdue_fine(loan)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p4_e7" sourceRef="p4_OR1" targetRef="p4_FD" name="есть ущерб">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">has_damage_fine(loan)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="p4_e8" sourceRef="p4_OR1" targetRef="p4_FZ" name="иначе"/>
    <bpmn:sequenceFlow id="p4_e9" sourceRef="p4_FL" targetRef="p4_OR2"/>
    <bpmn:sequenceFlow id="p4_e10" sourceRef="p4_FD" targetRef="p4_OR2"/>
    <bpmn:sequenceFlow id="p4_e11" sourceRef="p4_FZ" targetRef="p4_OR2"/>
    <bpmn:sequenceFlow id="p4_e12" sourceRef="p4_OR2" targetRef="p4_SUM"/>
    <bpmn:sequenceFlow id="p4_e13" sourceRef="p4_SUM" targetRef="p4_AND2"/>
    <bpmn:sequenceFlow id="p4_e14" sourceRef="p4_ST" targetRef="p4_AND2"/>
    <bpmn:sequenceFlow id="p4_e15" sourceRef="p4_AND2" targetRef="p4_CL"/>
    <bpmn:sequenceFlow id="p4_e16" sourceRef="p4_CL" targetRef="p4_EC"/>
  </bpmn:process>
